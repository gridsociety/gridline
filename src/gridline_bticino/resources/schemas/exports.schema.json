{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grid Society native SLD exports v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "vendor": {
      "const": "BTicino TiSystem"
    },
    "native_revision": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "tisystem-technical-a4-v1"
    },
    "design_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "properties": {
        "pdf": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "csv": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "report": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "project": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "pdf",
        "csv",
        "report",
        "project"
      ],
      "additionalProperties": false
    },
    "circuit_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
          },
          "board": {
            "type": "string",
            "minLength": 1
          },
          "native_line": {
            "type": "string",
            "minLength": 1
          },
          "expected_device": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "board",
          "native_line",
          "expected_device",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_page": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "legend",
              "single_line"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_page",
          "kind",
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "acknowledged_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "vendor",
    "native_revision",
    "profile",
    "design_sha256",
    "files",
    "circuit_map",
    "pages",
    "acknowledged_findings"
  ],
  "additionalProperties": false
}
